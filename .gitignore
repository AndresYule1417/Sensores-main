# � .gitignore para Proyecto Galpón IoT UCC - FastAPI + Streamlit

# Archivos Python temporales
__pycache__/
*.py[cod]
*$py.class
*.so

# Entornos virtuales
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
.ENV/

# Base de datos SQLite
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Logs del sistema
logs/*.log
*.log
galpon*.log
systemd*.log

# Archivos de configuración sensibles
config/*.env
config/.env
.env
.env.local
.env.production
*.key
*.pem
*.crt

# Streamlit
.streamlit/secrets.toml
.streamlit/config.toml

# Archivos temporales del sistema
.DS_Store
Thumbs.db
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# VS Code / IDEs
.vscode/
.vs/
*.swp
*.swo

# Archivos de distribución Python
dist/
build/
*.egg-info/
.eggs/

# Archivos de backup
backup_obsoletos/

# Documentos temporales
*.docx
*.xlsx
~$*

# Testing
test_data/
*.test

# Node modules (si se usa)
node_modules/

# Certificados y túneles
*.json
cloudflared/
ngrok/
certbot/

# IDEs y editores
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Archivos de desarrollo
test_*.py
debug_*.py
temp_*.py

# Documentación obsoleta
FIREBASE_*.md
MANUAL_*.md
README_*.md
*.swp
*.swo

# Archivos de configuración de VSCode
.vscode/

# Archivos de usuario de Windows
*.lnk

# OneDrive y carpetas de usuario
/OneDrive*/

# Backups locales (no subir a GitHub)
backups_local/
