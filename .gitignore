# 🐔 Sistema Galpón Avícola UCC - .gitignore

# Entornos virtuales Python
venv/
env/
ENV/
.venv/
.ENV/
__pycache__/

# Archivos de configuración sensibles
.env
.env.local
.env.production
*.key
*.pem

# Python
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Logs del sistema
logs/
*.log
galpon*.log
systemd*.log

# Streamlit
.streamlit/secrets.toml
.streamlit/config.toml

# Base de datos locales y backups
*.sql
*.db
*.sqlite
backups_local/
backup_*.sql

# Archivos de sistema
.DS_Store
Thumbs.db
*.bak
*.swp
*.tmp

# Certificados y túneles
*.json
cloudflared/
ngrok/
certbot/

# IDEs y editores
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Archivos de desarrollo
test_*.py
debug_*.py
temp_*.py

# Documentación obsoleta
FIREBASE_*.md
MANUAL_*.md
README_*.md
*.swp
*.swo

# Archivos de configuración de VSCode
.vscode/

# Archivos de usuario de Windows
*.lnk

# OneDrive y carpetas de usuario
/OneDrive*/

# Backups locales (no subir a GitHub)
backups_local/
